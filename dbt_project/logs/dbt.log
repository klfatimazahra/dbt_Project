  create temporary table "fact_rides__dbt_tmp205310640174"
  
  
    as
  
  (
    

with __dbt__cte__int_rides_enriched as (


with rides as (
    select * from "indrive_warehouse"."dbt_dev"."stg_ride_events"
),

current_drivers as (
    select *
    from "indrive_warehouse"."snapshots"."snap_drivers"
    where dbt_valid_to is null
),

vehicles as (
    select * from "indrive_warehouse"."dbt_dev"."stg_vehicles"
)

select
    r.ride_id,
    r.driver_id,
    r.pickup_zone_id,
    r.dropoff_zone_id,
    r.distance_km,
    r.fare_amount,
    r.requested_at,

    d.driver_name,
    d.rating as driver_rating,
    
    case
        when d.rating is null then 'Unrated'
        when d.rating < 4.5 then 'Below 4.5'
        when d.rating <= 4.8 then '4.5 - 4.8'
        else 'Above 4.8'
    end
 as driver_rating_bracket,
   
    v.vehicle_id,
    v.vehicle_type,
    v.make as vehicle_make,
    v.model as vehicle_model
from rides r
left join current_drivers d
    on r.driver_id = d.driver_id
left join vehicles v
    on r.driver_id = v.vehicle_id
) select
    ride_id,
    driver_id,
    vehicle_id,
    pickup_zone_id,
    dropoff_zone_id,
    distance_km,
    fare_amount,
    requested_at,
    driver_name,
    driver_rating,
    driver_rating_bracket,
    vehicle_type,
    vehicle_make,
    vehicle_model
from __dbt__cte__int_rides_enriched


where requested_at > (
    select coalesce(max(requested_at), '1900-01-01'::timestamp)
    from "indrive_warehouse"."dbt_dev"."fact_rides"
)

  );
  
  
