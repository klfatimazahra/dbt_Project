[0m20:46:22.758407 [debug] [Thread-3 (]: On model.indrive_analytics.mart_driver_daily_earnings: /* {"app": "dbt", "dbt_version": "1.13.0b1", "profile_name": "indrive_analytics", "target_name": "dev", "node_id": "model.indrive_analytics.mart_driver_daily_earnings"} */

  
    

  create  table "indrive_warehouse"."dbt_dev"."mart_driver_daily_earnings__dbt_tmp"
  
  
    as
  
  (
    with daily_driver_totals as (
    select
        driver_id,
        coalesce(driver_name, 'Unknown') as driver_name,
        date_trunc('day', requested_at)::date as ride_date,
        count(ride_id) as total_rides,
        sum(fare_amount) as daily_earnings
    from "indrive_warehouse"."dbt_dev"."fact_rides"
    group by 1, 2, 3
)

select
    driver_id,
    driver_name,
    ride_date,
    total_rides,
    daily_earnings,
    sum(daily_earnings) over (
        partition by driver_id
        order by ride_date
        rows between unbounded preceding and current row
    ) as cumulative_earnings,
    dense_rank() over (
        partition by ride_date
        order by daily_earnings desc
    ) as daily_earnings_rank
from daily_driver_totals
  );
  
